<?xml version="1.0" encoding="utf-8"?>
<!-- The TV's UI is 960x540 dp, on one 56 dp margin. The stage (photo and glass) is added behind
     these views in code, and the focus lens above them; every GlassLayout only marks a glass panel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="34dp"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:textColor="@color/text"
            android:textSize="104sp"
            android:translationX="-5dp" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="-12dp"
            android:format12Hour="EEEE  ·  d MMMM"
            android:format24Hour="EEEE  ·  d MMMM"
            android:letterSpacing="0.32"
            android:textAllCaps="true"
            android:textColor="@color/gold"
            android:textSize="11sp" />
    </LinearLayout>

    <site.gehlot.rattan.GlassLayout
        android:id="@+id/settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="56dp"
        android:clickable="true"
        android:contentDescription="@string/settings"
        android:focusable="true"
        app:cornerRadius="24dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:alpha="0.92"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_settings" />
    </site.gehlot.rattan.GlassLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="44dp"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <!-- Fixed sizes: new text only repaints, it never re-measures the screen. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/caption"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:alpha="0.75"
                    android:letterSpacing="0.32"
                    android:singleLine="true"
                    android:textAllCaps="true"
                    android:textColor="@color/gold"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:ellipsize="end"
                    android:gravity="bottom|start"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="48sp" />
            </LinearLayout>

            <site.gehlot.rattan.GlassLayout
                android:id="@+id/inputs"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginBottom="4dp"
                android:padding="4dp"
                app:cornerRadius="24dp">

                <LinearLayout
                    android:id="@+id/input_row"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </site.gehlot.rattan.GlassLayout>
        </LinearLayout>

        <!-- Banners have 10 dp corners: the dock's 30 dp minus its 20 dp padding, so the curves nest. -->
        <site.gehlot.rattan.GlassLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="20dp"
            app:cornerRadius="30dp">

            <LinearLayout
                android:id="@+id/app_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </site.gehlot.rattan.GlassLayout>
    </LinearLayout>
</FrameLayout>
